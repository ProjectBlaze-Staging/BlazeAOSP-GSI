<org.lineageos.setupwizard.widget.TouchRippleLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14">

    <org.lineageos.setupwizard.widget.LuminousBloomView
        android:id="@+id/finish_bloom_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/finish_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="68dp"
        android:paddingEnd="28dp"
        android:paddingBottom="36dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Clean Frosted Completion Medallion -->
        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/btn_pill_secondary"
            android:padding="20dp">

            <ImageView
                android:id="@+id/brand_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/logo" />
        </FrameLayout>

        <TextView
            android:id="@+id/finish_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:text="Her Şey Hazır"
            android:textColor="#F8FAFC"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/finish_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Cihazınız tercihlerinize göre yapılandırıldı.\nAna ekrana geçerek kullanmaya başlayabilirsiniz."
            android:textColor="#94A3B8"
            android:textSize="15sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/btn_pill_coloros"
            android:elevation="2dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/start"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</org.lineageos.setupwizard.widget.TouchRippleLayout>
