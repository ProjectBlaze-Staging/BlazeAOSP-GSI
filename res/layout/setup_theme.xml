<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0F16"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="44dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/theme_page_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:text="Görünüm ve Cam Yüzeyi"
                android:textColor="#F8FAFC"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/theme_page_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="Sistem temasını, yarı saydam cam dokusunu ve Dinamik Ada davranışını seçin."
                android:textColor="#94A3B8"
                android:textSize="14sp" />

            <!-- Live Interactive Preview Canvas -->
            <org.lineageos.setupwizard.widget.OobeLivePreviewView
                android:id="@+id/oobe_live_preview"
                android:layout_width="match_parent"
                android:layout_height="156dp"
                android:layout_marginTop="16dp" />

            <!-- Section 1: Dark vs Light Theme -->
            <TextView
                android:id="@+id/section_label_theme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="SİSTEM TEMASI"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Light Theme Card -->
                <LinearLayout
                    android:id="@+id/card_theme_light"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/icon_theme_light"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_theme"
                        android:tint="#F59E0B" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/title_theme_light"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Aydınlık Mod"
                            android:textColor="#F8FAFC"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/sub_theme_light"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Ferah ve yüksek kontrast"
                            android:textColor="#94A3B8"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <RadioButton
                        android:id="@+id/radio_light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <!-- Dark Theme Card -->
                <LinearLayout
                    android:id="@+id/card_theme_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/icon_theme_dark"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_theme"
                        android:tint="#60A5FA" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/title_theme_dark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Karanlık Mod"
                            android:textColor="#F8FAFC"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/sub_theme_dark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="OLED pil tasarrufu"
                            android:textColor="#94A3B8"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <RadioButton
                        android:id="@+id/radio_dark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section 2: Surface & Glass Style (No Brand/Trademark Names) -->
            <TextView
                android:id="@+id/section_label_glass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="CAM VE YÜZEY DOKUSU"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/card_glass_dark_crystal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title_glass_crystal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Koyu Kristal Cam"
                        android:textColor="#F8FAFC"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sub_glass_crystal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Derin füme cam katmanı, mercek vurgusu ve ince kenar kırılması"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/radio_glass_crystal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_glass_liquid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title_glass_liquid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Akıcı Liquid Glass"
                        android:textColor="#F8FAFC"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sub_glass_liquid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Dinamik yüzey kırılması, parlak cam yansıması ve yay fiziği"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/radio_glass_liquid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_glass_frosted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title_glass_frosted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Yumuşak Buzlu Cam"
                        android:textColor="#F8FAFC"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sub_glass_frosted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Mat buzlu bulanıklık, yüksek okunabilirlik ve dengeli güç tüketimi"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/radio_glass_frosted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <!-- Section 3: Dynamic Island Toggle -->
            <LinearLayout
                android:id="@+id/card_dynamic_island"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title_dynamic_island"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Dinamik Ada ve Canlı Etkinlik Kapsülü"
                        android:textColor="#F8FAFC"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sub_dynamic_island"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Zamanlayıcı, medya, kayıt ve bildirimleri üst kapsülde etkileşimli göster"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_dynamic_island"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Footer -->
    <LinearLayout
        android:id="@+id/theme_footer_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/theme_next_button"
            android:layout_width="160dp"
            android:layout_height="50dp"
            android:background="@drawable/btn_pill_coloros"
            android:fontFamily="sans-serif-medium"
            android:text="@string/next"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
