<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. ColorOS 17 Organic Luminous Bloom Background -->
    <org.lineageos.setupwizard.widget.LuminousBloomView
        android:id="@+id/bloom_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Interactive Touch Ripple & Gaze Layer -->
    <org.lineageos.setupwizard.widget.TouchRippleLayout
        android:id="@+id/touch_ripple_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="130dp"
            android:fitsSystemWindows="true">

            <!-- Top Area: Peeking Mascot under the punch-hole notch -->
            <org.lineageos.setupwizard.widget.PeekingMascotView
                android:id="@+id/peeking_mascot"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="12dp" />

            <!-- Typewriter Greetings + Gradient Subtitle -->
            <org.lineageos.setupwizard.widget.TypewriterTextView
                android:id="@+id/typewriter_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:layout_marginTop="20dp" />

            <!-- Compatibility views for BaseSetupWizardActivity / WelcomeActivity lookups -->
            <TextView
                android:id="@+id/welcome_title"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/brand_logo"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Center Area: Magnetic Particle Constellation Convergence -->
            <org.lineageos.setupwizard.widget.ParticleConvergenceView
                android:id="@+id/particle_convergence"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- Bottom Action Controls: Anchored firmly to bottom of FrameLayout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="42dp">

            <Button
                android:id="@+id/start"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/btn_pill_coloros"
                android:text="@string/start"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:elevation="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="14dp">

                <Button
                    android:id="@+id/emerg_dialer"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_pill_secondary"
                    android:text="@string/emergency_call"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

                <Space
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/launch_accessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_pill_secondary"
                    android:text="@string/accessibility_settings"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

                <Button
                    android:id="@+id/skip"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_pill_secondary"
                    android:text="@string/skip"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

    </org.lineageos.setupwizard.widget.TouchRippleLayout>

</FrameLayout>
