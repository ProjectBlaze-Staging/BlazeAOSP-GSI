<org.lineageos.setupwizard.widget.TouchRippleLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14">

    <!-- Calm Architectural Glass Backdrop -->
    <org.lineageos.setupwizard.widget.LuminousBloomView
        android:id="@+id/luminous_bloom_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Main Editorial Content Column -->
    <LinearLayout
        android:id="@+id/welcome_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="68dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.8" />

        <!-- Subtle Frosted Medallion + Brand Emblem -->
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/btn_pill_secondary"
            android:padding="14dp">

            <ImageView
                android:id="@+id/brand_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />
        </FrameLayout>

        <!-- Refined Architectural Headline -->
        <TextView
            android:id="@+id/welcome_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02"
            android:lineSpacingMultiplier="1.05"
            android:text="BlazeAOSP"
            android:textColor="#F8FAFC"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/welcome_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="4dp"
            android:text="Duruluktaki güç, kusursuz akıcılık.\nCihazınızı birkaç adımda kişisel tercihlerinize göre hazırlayın."
            android:textColor="#94A3B8"
            android:textSize="15sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2" />

        <!-- Frosted Glass Language Selector Card -->
        <LinearLayout
            android:id="@+id/language_selector_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/btn_pill_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="15dp"
            android:paddingEnd="18dp"
            android:paddingBottom="15dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_locale"
                android:tint="#93C5FD" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:text="SİSTEM DİLİ"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/current_locale_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Türkçe (Türkiye)"
                    android:textColor="#F8FAFC"
                    android:textSize="15.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#94A3B8"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- Secondary Utility Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/emerg_button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/btn_pill_secondary"
                android:text="@string/emergency_call"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <Button
                android:id="@+id/accessibility_button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/btn_pill_secondary"
                android:text="@string/accessibility_settings"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Primary Action Button -->
        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/btn_pill_coloros"
            android:elevation="2dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.01"
            android:text="@string/start"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</org.lineageos.setupwizard.widget.TouchRippleLayout>
